{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>netresearch/renovate-config"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/.mise/locks/**",
    "**/.config/mise/locks/**",
    "skills/*/evals/fixtures/**"
  ],
  "pre-commit": {
    "enabled": true
  }
}
